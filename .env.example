# ╔══════════════════════════════════════════════════════════════╗
# ║   ForMash 3D — Environment Configuration                   ║
# ║   Copy to .env and fill in your values                      ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Frontend ───────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL is DEPRECATED - leave empty for proper API proxying.
# The API proxy at /api/v1/[...path]/route.ts handles backend communication.
NEXT_PUBLIC_API_URL=

# BACKEND_URL is used by the API proxy route at runtime.
# For local development (backend on localhost/Colab): http://127.0.0.1:7842
BACKEND_URL=http://127.0.0.1:7842 # the actual backend port

# ── Redis (localhost) ──────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ── AI Provider ────────────────────────────────────────────────────────────────
# Default: 3DAIGC-API (backed by FastAPI + scheduler)
AI_PROVIDER=3d_aigc_api
RUNTIME_MODE=3d_aigc_api

# ── Environment & Python Runtime ───────────────────────────────────────────────
# Preferred manager: conda (default) or venv
FORMASH3D_ENV_MANAGER=conda
# Optional explicit Python 3.10 executable path (auto-set by install.sh)
PYTHON_EXEC=

# ── GPU / CUDA ─────────────────────────────────────────────────────────────────


# API Configuration
API_V1_PREFIX=/api/v1
DEBUG=false

# Optional server-wide API credential. Set security.api_key_required=true to require it.
# Never commit the actual key; use a secret manager/environment variable in deployments.
P3D_API_KEY=

# Provider Credentials (Optional)
HUGGINGFACE_TOKEN=
HF_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PROMPT_ENHANCEMENT_ENABLED=false
# ForMash 3D automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the ForMash 3D UI.

# ─────────────────────────────────────────────────────────────────

# auto = detect best GPU automatically
# cpu  = force CPU (slow but works without NVIDIA GPU)
# cuda:0, cuda:1 = specific GPU index
CUDA_DEVICE=auto

# Set to 0 to auto-detect total VRAM. Otherwise set MB limit (e.g. 16000)
MAX_VRAM_MB=0

# Keep this much VRAM free as safety margin (MB)
VRAM_SAFETY_MARGIN_MB=1024

# Model VRAM cache TTL in seconds. Keeps model resident in GPU VRAM for fast reuse across jobs.
# If a new job arrives for the same model within TTL, it runs instantly with 0 load time.
# If a new job requests a different model and GPU is full, idle models are evicted via LRU.
# Set to 0 to unload immediately after each job. Default: 300 (5 minutes).
P3D_MODEL_CACHE_TTL_SECONDS=300

# Legacy immediate unload switch (if true, overrides TTL to 0)
AUTO_UNLOAD_AFTER_JOB=false

# CPU resource policy for mesh/image processing. "auto" uses available logical cores.
FORMSH3D_CPU_THREADS=auto
FORMSH3D_CPU_WORKERS=auto

# ────────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./backend/storage
DOWNLOAD_CHUNK_SIZE_MB=5
DOWNLOAD_MAX_RETRIES=3
DOWNLOAD_TIMEOUT_SECONDS=300

# ── Blender ────────────────────────────────────────────────────────────────────
# Path to blender executable. On Ubuntu: /usr/bin/blender or ~/blender/blender
BLENDER_EXECUTABLE=blender
BLENDER_ENABLED=true
BLENDER_TIMEOUT=300

# ── Misc ───────────────────────────────────────────────────────────────────────
APP_NAME="ForMash 3D API"
APP_VERSION=0.1.0
ENVIRONMENT=production
MAX_CONCURRENT_JOBS=1

# ── Offline mode ───────────────────────────────────────────────────────────────
# Set to true after initial model download to prevent any internet access
OFFLINE_MODE=false

# UV Python path for uv pip (Python 3.10 required)
UV_PYTHON=python3.10
