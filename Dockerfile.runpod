# Single All-in-One Dockerfile for ForMash3D Studio (RunPod Optimized)
# Contains: CUDA 12.4, Python 3.10 Conda Env (3daigc-api), PyTorch 2.6.0,
#           All Generative 3D Model Adapters, Headless Blender Post-processing,
#           Embedded Redis Queue, Multi-Worker FastAPI Backend (Port 7842),
#           and Next.js Web Frontend (Port 3000) under Supervisor.

FROM nvidia/cuda:12.4.1-devel-ubuntu22.04 AS base

# Set non-interactive debian frontend
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}
ENV TORCH_CUDA_ARCH_LIST="7.5 8.0 8.6 8.9 9.0+PTX"

# Install essential system dependencies, headless Blender, Redis, Supervisor, sudo, jq, unzip
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    curl \
    git \
    sudo \
    jq \
    unzip \
    build-essential \
    cmake \
    ninja-build \
    libgl1-mesa-dev \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libegl1 \
    libegl1-mesa \
    libjpeg-dev \
    libwebp-dev \
    libgles2-mesa-dev \
    libosmesa6-dev \
    libxi6 \
    libxkbcommon-dev \
    xvfb \
    blender \
    redis-server \
    supervisor \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Miniconda to /opt/conda for the persistent Conda environment
RUN wget -q https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O miniconda.sh && \
    bash miniconda.sh -b -p /opt/conda && \
    rm miniconda.sh
ENV PATH="/opt/conda/bin:${PATH}"

# Set working directory
WORKDIR /app

# Copy the entire project
COPY . .

# Setup proxy settings passed via build args if any
ARG http_proxy
ARG https_proxy
ARG no_proxy
ENV http_proxy=$http_proxy
ENV https_proxy=$https_proxy
ENV no_proxy=$no_proxy

# Execute project setup and install scripts with --auto, --skip-cuda, and --conda
# Environment & dependency contracts (managed automatically via scripts/setup.sh -> backend/scripts/install.sh):
# - Target Python: python=3.10 in conda env 3daigc-api
# - PyTorch baseline: torch==2.6.0 with cu124 support
# - Dependency sequence: /app/backend/requirements.txt installed prior to /app/backend/thirdparty/TripoSG/requirements.txt
# This automatically handles:
# 1. Directory creation
# 2. Prebuilt release wheels download
# 3. Bun & Frontend dependencies install & Next.js production build
# 4. Conda 3daigc-api creation (Python 3.10)
# 5. PyTorch with CUDA 12.4
# 6. TRELLIS.2, Hunyuan3D, PartField, UniRig, PartPacker, and all model dependencies
RUN chmod +x scripts/*.sh backend/scripts/*.sh manager.sh && \
    bash scripts/setup.sh --auto --skip-cuda --conda

# Create runtime directories
RUN mkdir -p /app/backend/storage/uploads \
             /app/backend/storage/models/meshes \
             /app/backend/storage/thumbnails \
             /app/backend/storage/images \
             /app/logs

# Setup Supervisor configuration
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Configure bash environment so interactive shells auto-activate conda
RUN echo "source /opt/conda/etc/profile.d/conda.sh && conda activate 3daigc-api" >> /root/.bashrc && \
    echo "export PATH=\"/root/.bun/bin:/opt/conda/envs/3daigc-api/bin:\$PATH\"" >> /root/.bashrc && \
    echo "export PYTHONPATH=\"/app/backend:/app\"" >> /root/.bashrc

# Set runtime environment variables
ENV PYTHONPATH="/app/backend:/app"
ENV CONDA_DEFAULT_ENV=3daigc-api
ENV ENVIRONMENT=production

ENV http_proxy=""
ENV https_proxy=""
ENV no_proxy=""
ENV HTTP_PROXY=""
ENV HTTPS_PROXY=""
ENV NO_PROXY=""

# Expose Next.js Frontend (3000) and FastAPI Backend (7842)
EXPOSE 3000 7842

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:7842/health && curl -f http://localhost:3000 || exit 1

# Start Supervisor managing Redis, Scheduler, API, and Frontend
CMD ["/bin/bash", "-c", "rm -f /var/run/supervisord.pid /var/run/supervisor.sock && exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf"]
