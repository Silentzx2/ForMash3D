+# Config-driven presets for Hunyuan3D-2.1 with measured time/VRAM and hole-repair thresholds
+version: 1
+
+presets:
+  fast:
+    octree_resolution: 380
+    num_inference_steps: 30
+    guidance_scale: 5.0
+    vram_budget_gb: 8.0
+  balanced:
+    octree_resolution: 512
+    num_inference_steps: 50
+    guidance_scale: 7.5
+    vram_budget_gb: 10.0
+  high:
+    octree_resolution: 512
+    num_inference_steps: 100
+    guidance_scale: 7.5
+    vram_budget_gb: 14.0
+
+hole_repair:
+  max_hole_perimeter: 0.5
+  max_hole_vertices: 50
+
+# Flat aliases for direct dictionary access
+fast:
+  octree_resolution: 380
+  num_inference_steps: 30
+  guidance_scale: 5.0
+  vram_budget_gb: 8.0
+
+balanced:
+  octree_resolution: 512
+  num_inference_steps: 50
+  guidance_scale: 7.5
+  vram_budget_gb: 10.0
+
+high:
+  octree_resolution: 512
+  num_inference_steps: 100
+  guidance_scale: 7.5
+  vram_budget_gb: 14.0
+
+max_hole_perimeter: 0.5
+max_hole_vertices: 50
diff --git a/backend/config/planner_rules.yaml b/backend/config/planner_rules.yaml
new file mode 100644
index 00000000..c35f87b1
--- /dev/null
+++ b/backend/config/planner_rules.yaml
@@ -0,0 +1,259 @@
+schema_version: "1.0.0"
+
+# Adapter capabilities and resource constraints
+adapters:
+  hunyuan3d_shape_v21_image_to_raw_mesh:
+    adapter_class: "Hunyuan3DShapeV21ImageToRawMeshAdapter"
+    vram_budget_gb: 10.0
+    supported_inputs: ["image"]
+    requires_cuda: true
+    native_topology: false
+    requires_license_optin: false
+
+  hunyuan3d_dit_v2_mini_turbo_image_to_raw_mesh:
+    adapter_class: "Hunyuan3DDiTV2MiniTurboImageToRawMeshAdapter"
+    vram_budget_gb: 6.0
+    supported_inputs: ["image"]
+    requires_cuda: true
+    native_topology: false
+    requires_license_optin: false
+
+  trellis2_image_to_raw_mesh:
+    adapter_class: "Trellis2ImageToRawMeshAdapter"
+    vram_budget_gb: 16.0
+    supported_inputs: ["image"]
+    requires_cuda: true
+    native_topology: false
+    requires_license_optin: false
+
+  taoflowforge_image_to_raw_mesh:
+    adapter_class: "TaoFlowForgeImageToRawMeshAdapter"
+    vram_budget_gb: 16.0
+    supported_inputs: ["image"]
+    requires_cuda: true
+    native_topology: true
+    requires_license_optin: true
+
+# Benchmark-driven routing candidates by object type and requested quality tier
+object_type_routes:
+  mechanical:
+    description: "Hard-surface mechanical objects requiring sharp crease and feature-edge preservation"
+    retopo_mode: "feature_aware"
+    fast:
+      candidates:
+        - adapter: "hunyuan3d_shape_v21_image_to_raw_mesh"
+          preset: "fast"
+          num_seeds: 1
+          skip_retopo_allowed: false
+          retopo_mode: "feature_aware"
+    balanced:
+      candidates:
+        - adapter: "trellis2_image_to_raw_mesh"
+          preset: "balanced"
+          num_seeds: 2
+          skip_retopo_allowed: false
+          retopo_mode: "feature_aware"
+        - adapter: "hunyuan3d_shape_v21_image_to_raw_mesh"
+          preset: "balanced"
+          num_seeds: 2
+          skip_retopo_allowed: false
+          retopo_mode: "feature_aware"
+    high:
+      candidates:
+        - adapter: "trellis2_image_to_raw_mesh"
+          preset: "high"
+          num_seeds: 3
+          skip_retopo_allowed: false
+          retopo_mode: "feature_aware"
+        - adapter: "hunyuan3d_shape_v21_image_to_raw_mesh"
+          preset: "high"
+          num_seeds: 3
+          skip_retopo_allowed: false
+          retopo_mode: "feature_aware"
+
+  organic:
+    description: "Curved organic shapes prioritizing smooth curvature and surface continuity"
+    retopo_mode: "smooth"
+    fast:
+      candidates:
+        - adapter: "hunyuan3d_shape_v21_image_to_raw_mesh"
+          preset: "fast"
+          num_seeds: 1
+          skip_retopo_allowed: false
+          retopo_mode: "smooth"
+    balanced:
+      candidates:
+        - adapter: "trellis2_image_to_raw_mesh"
+          preset: "balanced"
+          num_seeds: 2
+          skip_retopo_allowed: false
+          retopo_mode: "smooth"
+        - adapter: "hunyuan3d_shape_v21_image_to_raw_mesh"
+          preset: "balanced"
+          num_seeds: 2
+          skip_retopo_allowed: false
+          retopo_mode: "smooth"
+    high:
+      candidates:
+        - adapter: "trellis2_image_to_raw_mesh"
+          preset: "high"
+          num_seeds: 3
+          skip_retopo_allowed: false
+          retopo_mode: "smooth"
+        - adapter: "hunyuan3d_shape_v21_image_to_raw_mesh"
+          preset: "high"
+          num_seeds: 3
+          skip_retopo_allowed: false
+          retopo_mode: "smooth"
+
+  character:
+    description: "Characters and figurines prioritizing silhouette fidelity and bilateral symmetry"
+    retopo_mode: "silhouette_aware"
+    fast:
+      candidates:
+        - adapter: "hunyuan3d_shape_v21_image_to_raw_mesh"
+          preset: "fast"
+          num_seeds: 1
+          skip_retopo_allowed: false
+          retopo_mode: "silhouette_aware"
+    balanced:
+      candidates:
+        - adapter: "trellis2_image_to_raw_mesh"
+          preset: "balanced"
+          num_seeds: 2
+          skip_retopo_allowed: false
+          retopo_mode: "silhouette_aware"
+        - adapter: "hunyuan3d_shape_v21_image_to_raw_mesh"
+          preset: "balanced"
+          num_seeds: 2
+          skip_retopo_allowed: false
+          retopo_mode: "silhouette_aware"
+    high:
+      candidates:
+        - adapter: "trellis2_image_to_raw_mesh"
+          preset: "high"
+          num_seeds: 3
+          skip_retopo_allowed: false
+          retopo_mode: "silhouette_aware"
+        - adapter: "hunyuan3d_shape_v21_image_to_raw_mesh"
+          preset: "high"
+          num_seeds: 3
+          skip_retopo_allowed: false
+          retopo_mode: "silhouette_aware"
+
+  general:
+    description: "General objects and props with balanced default settings"
+    retopo_mode: "standard"
+    fast:
+      candidates:
+        - adapter: "hunyuan3d_shape_v21_image_to_raw_mesh"
+          preset: "fast"
+          num_seeds: 1
+          skip_retopo_allowed: false
+          retopo_mode: "standard"
+    balanced:
+      candidates:
+        - adapter: "trellis2_image_to_raw_mesh"
+          preset: "balanced"
+          num_seeds: 2
+          skip_retopo_allowed: false
+          retopo_mode: "standard"
+        - adapter: "hunyuan3d_shape_v21_image_to_raw_mesh"
+          preset: "balanced"
+          num_seeds: 2
+          skip_retopo_allowed: false
+          retopo_mode: "standard"
+    high:
+      candidates:
+        - adapter: "trellis2_image_to_raw_mesh"
+          preset: "high"
+          num_seeds: 3
+          skip_retopo_allowed: false
+          retopo_mode: "standard"
+        - adapter: "hunyuan3d_shape_v21_image_to_raw_mesh"
+          preset: "high"
+          num_seeds: 3
+          skip_retopo_allowed: false
+          retopo_mode: "standard"
+
+# Baseline routing candidates by requested quality tier (for backwards compatibility and general fallback)
+quality_routes:
+  fast:
+    candidates:
+      - adapter: "hunyuan3d_shape_v21_image_to_raw_mesh"
+        preset: "fast"
+        num_seeds: 1
+        skip_retopo_allowed: false
+  balanced:
+    candidates:
+      - adapter: "trellis2_image_to_raw_mesh"
+        preset: "balanced"
+        num_seeds: 2
+        skip_retopo_allowed: false
+      - adapter: "hunyuan3d_shape_v21_image_to_raw_mesh"
+        preset: "balanced"
+        num_seeds: 2
+        skip_retopo_allowed: false
+  high:
+    candidates:
+      - adapter: "trellis2_image_to_raw_mesh"
+        preset: "high"
+        num_seeds: 3
+        skip_retopo_allowed: false
+      - adapter: "hunyuan3d_shape_v21_image_to_raw_mesh"
+        preset: "high"
+        num_seeds: 3
+        skip_retopo_allowed: false
+
+# Style & object type routing modifiers
+specialized_routes:
+  native_clean:
+    native_candidate:
+      adapter: "taoflowforge_image_to_raw_mesh"
+      skip_retopo_allowed: true
+    fallback_to_dense: true
+    dense_retopo_mode: "feature_aware"
+
+# Retopology configurations per mode
+retopo_configs:
+  feature_aware:
+    crease_angle_deg: 35.0
+    preserve_feature_edges: true
+  smooth:
+    crease_angle_deg: 60.0
+    preserve_feature_edges: false
+  silhouette_aware:
+    crease_angle_deg: 45.0
+    preserve_feature_edges: true
+  standard:
+    crease_angle_deg: 45.0
+    preserve_feature_edges: false
+
+# Fallback of last resort (always available candidate)
+fallback_of_last_resort:
+  adapter: "hunyuan3d_shape_v21_image_to_raw_mesh"
+  preset: "fast"
+  num_seeds: 1
+  skip_retopo_allowed: false
+
+# Default input prep flags
+default_input_prep:
+  remove_background: true
+  clean_alpha: true
+  tight_crop: true
+  margin: 0.1
+  resize: true
+  target_size: 1024
+  upscale_small: true
+  upscale_threshold: 512
+
+# Default UV options
+default_uv:
+  backend: "auto"
+  partuv_threshold_tris: 500000
+
+# Default bake options
+default_bake:
+  normal_from_master: true
+  convention: "opengl"
+  bake_ao: false
