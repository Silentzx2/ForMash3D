+
+def test_plan_generation_organic_routing():
+    """Verify organic object type routes to smooth retopo mode."""
+    runtime = _get_mock_runtime(has_cuda=True, free_vram_gb=24.0)
+    plan = plan_generation(
+        {
+            "mesh_style": "auto",
+            "object_type": "organic",
+            "requested_quality": "balanced",
+        },
